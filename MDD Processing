INPUTDIR="/Users/bpereira/Desktop/MDD/Processing/Files"
OUTPUTDIR="/Users/bpereira/Desktop/MDD/Processing/Analysis"
HUMANMIRBASEINDEX="/Users/bpereira/Desktop/MDD/Processing/Analysis/Databases"
mkdir $INPUTDIR/QCReports 
mkdir $OUTPUTDIR/maturemiRNAcounts
rm -f Undetermined_file_name.fastq.gz 

for gz_file in "$INPUTDIR"/*.fastq.gz
do
  filename=$(basename "$gz_file")
  prefix="${filename%%.fastq.gz}"

  echo "🔄 Processing: $prefix"

  mkdir -p "$OUTPUTDIR/$prefix"

 bbduk.sh -Xmx27g \
    in="$gz_file" \
    out="$OUTPUTDIR/$prefix/${prefix}-Trimmed.fastq" \
    literal=TGGAATTCTCGGGTGCCAAGGAACTCCAGTCAC \
    ktrim=r k=21 mink=11 hdist=2

bowtie -v 1 -k 1 -m 1 --best --threads 16 -S \
    "$HUMANMIRBASEINDEX/mirbase_hsa_index" \
    -q "$OUTPUTDIR/$prefix/${prefix}-Trimmed.fastq" \
    --un "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-unalignedReads-bowtie1-beststratam1.fastq" \
    -S "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.sam" \
    2> "$OUTPUTDIR/$prefix/${prefix}-bowtie-maturemiRNA-beststratam1.log"

  samtools sort "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.sam" \
    -o "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.bam"

  samtools index "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.bam"

  rm -f "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.sam"

  samtools idxstats "$OUTPUTDIR/$prefix/${prefix}-maturemiRNA-aligned-bowtie1-beststratam1.bam" \
    | cut -f1,3 - \
    | uniq -c \
    | sort -nr \
    | sed "1s/^/miRNA\t${prefix}-miRNAcount\n/" \
    > "$OUTPUTDIR/maturemiRNAcounts/${prefix}-maturemiRNA-counts.txt"

done
